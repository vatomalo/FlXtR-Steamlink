@@ -95,6 +96,16 @@ static INLINE uint16_t *flxtr_name_tint(const uint16_t *source)
          palette[5 + i] = BUILD_PIXEL(IPPU.XB[rgb & 31],
                IPPU.XB[(rgb >> 5) & 31], IPPU.XB[(rgb >> 10) & 31]);
    }
+   /* The creator's hair colour: entries 2-4 (dark to light), and the
+    * sprite's hair puffs at 8. */
+   for (i = 0; flxtr_name_hair && IPPU.XB && i < 3; i++)
+   {
+      const unsigned rgb = flxtr_name_hair[i];
+      palette[2 + i] = BUILD_PIXEL(IPPU.XB[rgb & 31],
+            IPPU.XB[(rgb >> 5) & 31], IPPU.XB[(rgb >> 10) & 31]);
+      if (i == 1 && flxtr_name_actor == 2)
+         palette[8] = palette[3];
+   }
    return palette;
