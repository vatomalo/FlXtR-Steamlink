# Overrides for flxtr-som-ai-android.service, loaded after som-ai.env so the
# Steam Link bridge (flxtr-som-ai.service) and the Android relay run together.
SOM_AI_ANDROID=1
SOM_AI_ANDROID_LISTEN=100.69.7.81:43928
# Each game keeps its own survival/intention state: separate history database
# (seeded from the Steam Link one on first start, so learned maps carry over).
SOM_AI_INSTANCE=android
