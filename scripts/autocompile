#!/usr/bin/env bash
# Build the public source inside a Steam Link SDK container. No deployment secrets.
set -euo pipefail
if [[ ${1:-} == --psp ]]; then
    shift
    helper="$(dirname "$(readlink -f "$0")")/build-psp.sh"
    [[ -f "$helper" ]] || helper="${FLXTR_SOURCE_DIR:-/opt/FlXtR-Steamlink}/scripts/build-psp.sh"
    exec bash "$helper" "$@"
fi
# Linux download/install mode is separate from the original SDK build path.
if [[ " ${*} " == *" --download "* || " ${*} " == *" --install "* || " ${*} " == *" --linux "* ]]; then
    if [[ " ${*} " == *" --steamlink "* ]]; then
        echo 'Choose --steamlink or Linux build/download/install options, not both.' >&2
        exit 2
    fi
    linux_args=()
    for arg in "$@"; do [[ "$arg" = --linux ]] || linux_args+=("$arg"); done
    if [[ " ${*} " == *" --linux "* ]]; then
        export FLXTR_LINUX_OUTPUT_DIR=${FLXTR_LINUX_OUTPUT_DIR:-/build}
        if [[ " ${*} " != *" --download "* && " ${*} " != *" --build "* ]]; then linux_args+=(--build); fi
    fi
    helper="$(dirname "$(readlink -f "$0")")/autobuild"
    if [[ ! -f "$helper" ]]; then helper="${FLXTR_SOURCE_DIR:-/opt/FlXtR-Steamlink}/scripts/autobuild"; fi
    [[ -f "$helper" ]] || { echo 'Install scripts/autobuild beside autocompile, or run it from the checkout.' >&2; exit 1; }
    exec bash "$helper" "${linux_args[@]}"
fi
repo=https://github.com/vatomalo/FlXtR-Steamlink.git
source_dir=${FLXTR_SOURCE_DIR:-/opt/FlXtR-Steamlink}
export GREENLINK_BUILD_CACHE=${GREENLINK_BUILD_CACHE:-/var/cache/flxtr-steamlink}
export STEAMLINK_SDK_PATH=${STEAMLINK_SDK_PATH:-/opt/steamlink-sdk}
shell_only=0
update=1
publish=0
usage() {
    cat <<'HELP'
Usage: autocompile [--steamlink] [--shell-only] [--no-update] [--publish]
       autocompile --linux [--download | --build] [--install] [--deps]
       autocompile --psp

--linux compiles by default and leaves /build/greenlink plus /build/FlXtR.sh.
Override /build with FLXTR_LINUX_OUTPUT_DIR. --download skips compilation.

Clone/update vatomalo/FlXtR-Steamlink and build an installable Steam Link package.
  --steamlink   Explicitly select the default Steam Link SDK build.
  --shell-only  Build the UI without compiling the video player.
  --publish     Upload shell executable as a GitHub release (GH_TOKEN or token on stdin).
  --no-update   Use the current checkout without fetching GitHub changes.
  -h, --help    Show this help.

Defaults:
  source: /opt/FlXtR-Steamlink
  cache:  /var/cache/flxtr-steamlink
  SDK:    /opt/steamlink-sdk

Override with FLXTR_SOURCE_DIR, GREENLINK_BUILD_CACHE, STEAMLINK_SDK_PATH or JOBS.
Updates fast-forward main only. Local modifications are never reset or discarded.
With --publish, installed apps download the shell on their next launch.
Does not directly connect to or interrupt the Steam Link.
HELP
}
for arg in "$@"; do
    case "$arg" in
        --steamlink) ;;
        --shell-only) shell_only=1 ;;
        --no-update) update=0 ;;
        --publish) publish=1 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
    esac
done
if [[ ! -f "$STEAMLINK_SDK_PATH/setenv.sh" ]]; then
    printf 'Steam Link SDK is not available in this shell: %s\n' "$STEAMLINK_SDK_PATH" >&2
    printf 'For native Linux and /build/FlXtR.sh, run: %s --linux\n' "$0" >&2
    if command -v steamlinkSDK >/dev/null 2>&1; then
        printf 'For Steam Link, enter your SDK container with steamlinkSDK, then run autocompile there.\n' >&2
    else
        printf 'For Steam Link, run inside your SDK container or set STEAMLINK_SDK_PATH.\n' >&2
    fi
    exit 1
fi
if [[ ! -e "$source_dir" ]]; then
    git clone --branch main --single-branch "$repo" "$source_dir"
elif [[ ! -d "$source_dir/.git" ]]; then
    printf 'Source path is not a Git checkout: %s\n' "$source_dir" >&2; exit 1
fi
cd "$source_dir"
if (( update )); then
    if [[ -n "$(git status --porcelain)" ]]; then
        printf 'Local changes found. Commit them or use --no-update; nothing was overwritten.\n' >&2; exit 1
    fi
    if [[ "$(git branch --show-current)" != main ]]; then
        printf 'Checkout is not on main. Select main or use --no-update.\n' >&2; exit 1
    fi
    origin=$(git remote get-url origin)
    if [[ "${origin%.git}" != "${repo%.git}" ]]; then
        printf 'Unexpected origin. Use the intended checkout or --no-update.\n' >&2; exit 1
    fi
    git fetch origin main
    git merge --ff-only origin/main
fi
mkdir -p "$GREENLINK_BUILD_CACHE"
if (( ! shell_only )); then bash scripts/build-player.sh; bash scripts/build-resolver.sh; fi
bash scripts/build-steamlink.sh
{
    printf 'commit=%s\n' "$(git rev-parse HEAD)"
    printf 'built_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    sha256sum dist/greenlink.tgz
} > dist/build-info.txt
printf '\nBuild ready: %s/dist/greenlink.tgz\n' "$source_dir"
printf 'Manifest:    %s/dist/build-info.txt\n' "$source_dir"

if (( publish )); then python3 scripts/publish-shell.py; fi
