{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flxtr/som/perks.schema.json",
  "title": "SoM inherited perk database",
  "description": "Shape of data/perks/perks.json for editors. tools/generate_perk_registry.py checks the same rules (and more: id ranges per discipline, tier levels, prerequisite cycles, capability names) without third-party modules.",
  "type": "object",
  "required": ["version", "disciplines", "tiers", "capacity", "max_equipped", "perks", "builds"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "disciplines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "som_index", "title", "id_base"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z_]+$"},
          "som_index": {"type": "integer", "description": "index in som_discipline_names, 255 = universal"},
          "title": {"type": "string"},
          "id_base": {"type": "integer", "description": "perk ids are id_base+1 .. id_base+99"},
          "note": {"type": "string"}
        }
      }
    },
    "tiers": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 99}},
    "capacity": {
      "type": "object",
      "required": ["base", "per_hero_levels", "max"],
      "properties": {"base": {"type": "integer"}, "per_hero_levels": {"type": "integer"}, "max": {"type": "integer"}}
    },
    "max_equipped": {"type": "integer", "minimum": 1, "maximum": 16},
    "perks": {"type": "array", "minItems": 200, "items": {"$ref": "#/$defs/perk"}},
    "builds": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "required": ["name", "primary", "kind", "perks", "idea"],
        "properties": {
          "name": {"type": "string"}, "primary": {"type": "string"}, "kind": {"type": "string"},
          "perks": {"type": "array", "items": {"type": "string"}}, "idea": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "perk": {
      "type": "object",
      "required": ["id", "key", "name", "discipline", "category", "tier", "role", "mastery_required", "capacity_cost",
                   "description", "triggers", "conditions", "effects", "cooldown_frames", "proc_chance",
                   "stacking_policy", "max_stacks", "charges", "prerequisites", "boss_ok", "generated_can_trigger",
                   "ai_tactic", "tags", "sources"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "stable, stored in saves; never renumber"},
        "key": {"type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$", "description": "stable symbolic id"},
        "name": {"type": "string", "maxLength": 24},
        "discipline": {"type": "string"},
        "branch": {"type": ["string", "null"], "description": "sub-branch, e.g. chronomancy"},
        "category": {"enum": ["attribute", "technique", "trigger", "transformative", "keystone"]},
        "tier": {"enum": ["novice", "apprentice", "adept", "expert", "master", "grandmaster"]},
        "role": {"enum": ["combat", "trigger", "defense", "resource", "party", "explore", "economy"]},
        "mastery_required": {"type": "integer", "minimum": 1, "maximum": 99},
        "capacity_cost": {"type": "integer", "minimum": 1, "maximum": 8},
        "description": {"type": "string", "maxLength": 160, "description": "English source text; localisation keys off 'key'"},
        "triggers": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
        "conditions": {"type": "array", "maxItems": 3, "items": {"type": "string", "description": "name or name:arg[,arg2]"}},
        "effects": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}},
                    "additionalProperties": {"type": ["number", "string", "boolean"]}}
        },
        "cooldown_frames": {"type": "integer", "minimum": 0, "maximum": 36000},
        "proc_chance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "stacking_policy": {"enum": ["refresh", "add", "ignore"]},
        "max_stacks": {"type": "integer", "minimum": 1, "maximum": 10},
        "charges": {"type": "integer", "minimum": 0, "maximum": 10},
        "prerequisites": {"type": "array", "items": {"type": "string"}, "description": "perk keys that must be unlocked first"},
        "exclusive_group": {"type": ["string", "null"], "description": "only one perk of a group may be equipped"},
        "boss_ok": {"type": "boolean"},
        "generated_can_trigger": {"type": "boolean", "description": "may effects generated by other perks set this one off"},
        "ai_tactic": {"type": "string"},
        "feedback": {"type": ["string", "null"], "maxLength": 12},
        "tags": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"enum": ["discipline_mastery", "equipment", "temporary_buff", "story_unlock", "universal_progression"]}}
      }
    }
  }
}
