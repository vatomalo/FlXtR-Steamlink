+#ifdef USE_BLARGG_APU
+/* FlXtR: skip synthesising Secret of Mana's music (see apu_blargg.c
+   dsp_run_fx0). 0 = full mixing, 1 = voices 0-5 off, 2 = only the voices
+   sound effects own (SPC700 $AE). */
+extern int flxtr_skip_music_voices;
+RETRO_API void retro_flxtr_skip_music_voices(int mode)
+{
+   flxtr_skip_music_voices = mode >= 0 && mode <= 2 ? mode : 0;
+}
