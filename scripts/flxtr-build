#!/usr/bin/env bash
# SkyLoft command: update the selected branch without discarding local work.
set -euo pipefail
usage(){
    cat <<'HELP'
Usage: flxtr-build --android|--steamlink|--linux|--windows|--desktop|--all
                   [--branch NAME] [--arch ARCH]
                   [--release-title TEXT] [--notes-file PATH] [--no-publish]

Pulls the selected branch from origin using fast-forward only, then builds.
Without --branch, builds the currently checked-out branch. Multiple targets
run sequentially. Successful builds publish to the normal update channels.
Use --no-publish to keep builds local. Logs are saved on SkyLoft.
Android architectures: universal (default), arm64, armv7. Steam Link is armv7.
Linux and Windows are x86_64. --desktop builds both; --all builds all four.
Single-architecture APKs publish as separate downloads, keeping the universal
auto-update channel compatible with both Android architectures.

Examples:
  flxtr-build --android
  flxtr-build --steamlink --branch codex/send-to-tv-settings
  flxtr-build --all --branch main
  flxtr-build --android --no-publish
HELP
}
android=0 steamlink=0 linux=0 windows=0 branch= publish=1 arch=auto notes= title= output=
while (($#)); do
    case "$1" in
        --android) android=1; shift;;
        --steamlink) steamlink=1; shift;;
        --linux) linux=1; shift;;
        --windows|--win) windows=1; shift;;
        --desktop) linux=1; windows=1; shift;;
        --all) android=1; steamlink=1; linux=1; windows=1; shift;;
        --no-publish) publish=0; shift;;
        --arch|--notes-file|--release-title|--output-dir)
            [[ $# -ge 2 && -n "$2" ]] || { echo "$1 requires a value." >&2; exit 2; }
            case "$1" in --arch) arch=$2;; --notes-file) notes=$2;; --release-title) title=$2;; --output-dir) output=$2;; esac
            shift 2;;
        --branch) [[ $# -ge 2 && -n "$2" ]] || { echo '--branch requires a name.' >&2; exit 2; }; branch=$2; shift 2;;
        --branch=*) branch=${1#*=}; [[ -n "$branch" ]] || { echo '--branch requires a name.' >&2; exit 2; }; shift;;
        -h|--help) usage; exit 0;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2;;
    esac
done
((android||steamlink||linux||windows)) || { usage >&2; exit 2; }
if [[ "$arch" == auto ]]; then
    if ((android)); then arch=universal; elif ((linux||windows)); then arch=x86_64; else arch=armv7; fi
fi
case "$arch" in universal|arm64|armv7|x86_64) ;; *) echo 'Unsupported architecture.' >&2; exit 2;; esac
if ((android)) && [[ "$arch" == x86_64 ]]; then echo 'Android uses universal, arm64 or armv7.' >&2; exit 2; fi
if ((!android && (linux||windows))) && [[ "$arch" != x86_64 ]]; then echo 'Desktop builds use x86_64.' >&2; exit 2; fi
if ((!android && !linux && !windows)) && [[ "$arch" != armv7 ]]; then echo 'Steam Link uses armv7.' >&2; exit 2; fi
if [[ -n "$notes" ]]; then
    [[ -f "$notes" && -r "$notes" && $(wc -c < "$notes") -le 16384 ]] || { echo 'Release notes must be a readable file of at most 16 KiB.' >&2; exit 2; }
    notes=$(realpath "$notes")
fi
[[ ${#title} -le 160 && "$title" != *$'\n'* && "$title" != *$'\r'* ]] || { echo 'Release title must be one line, at most 160 characters.' >&2; exit 2; }
export FLXTR_RELEASE_NOTES_FILE="$notes" FLXTR_RELEASE_TITLE="$title" FLXTR_RELEASE_ARCH="$arch"
case "$arch" in universal) FLXTR_ANDROID_ABIS=armeabi-v7a,arm64-v8a;; arm64) FLXTR_ANDROID_ABIS=arm64-v8a;; armv7) FLXTR_ANDROID_ABIS=armeabi-v7a;; esac
export FLXTR_ANDROID_ABIS
storage=${FLXTR_STORAGE:-/opt/dockers/storage}
repo=${FLXTR_BUILD_SOURCE:-$storage/projects/FlXtR/source}
mountpoint -q "$storage" || { echo 'Docker storage disk is not mounted.' >&2; exit 1; }
mkdir -p "$storage/build-home" "$storage/build-logs"
exec 9>"$storage/build-home/flxtr-build.lock"
flock -n 9 || { echo 'Another FlXtR build is running. Try again after it finishes.' >&2; exit 1; }
export FLXTR_BUILD_LOCK_HELD=1
log="$storage/build-logs/flxtr-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
exec > >(tee -a "$log") 2>&1
printf 'Build log: %s\n' "$log"
trap 'result=$?; if ((result)); then printf "Build failed (exit %s). Log: %s\n" "$result" "$log"; fi' EXIT
cd "$repo"
# Builds generate files in source-adjacent directories. Older checked-out
# branches may not ignore them, so clean only these known outputs before the
# safety check. Tracked files and unknown untracked work remain untouched.
generated=(
    android/.gradle android/app/.cxx android/app/libs
    android/app/src/main/jniLibs android/local.properties
    android/moonlight/AndroidManifest.xml
    companion/FlXtR.Gamez/bin companion/FlXtR.Gamez/obj
)
if [[ -n "$(git status --porcelain --untracked-files=all -- "${generated[@]}")" ]]; then
    echo 'Cleaning generated files from the build checkout…'
    git clean -fdx -- "${generated[@]}"
fi
[[ -z "$(git status --porcelain)" ]] || { echo 'Source changes remain after generated-file cleanup. Commit or stash them first; nothing was overwritten.' >&2; exit 1; }
[[ -n "$branch" ]] || branch=$(git branch --show-current)
[[ -n "$branch" && "$branch" != -* ]] && git check-ref-format "refs/heads/$branch" || { echo 'Specify a valid branch name with --branch NAME.' >&2; exit 2; }
printf 'Pulling origin/%s…\n' "$branch"
git fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch"
remote="refs/remotes/origin/$branch"
if git show-ref --verify --quiet "refs/heads/$branch"; then
    git merge-base --is-ancestor "refs/heads/$branch" "$remote" || { echo 'Local branch has unpushed or conflicting commits. Nothing was reset.' >&2; exit 1; }
    git switch -- "$branch"
    git merge --ff-only --no-edit "$remote"
else
    git switch --no-track -c "$branch" "$remote"
fi
printf 'Building branch %s, commit %s\n' "$branch" "$(git rev-parse HEAD)"
# Keep server runners outside the checkout: older branches may predate them.
export FLXTR_BUILD_SOURCE="$PWD"
helpers="$storage/tools/libexec/flxtr-build"
mkdir -p "$helpers"
for runner in build-skyloft-android.sh build-skyloft-steamlink.sh build-skyloft-desktop.sh publish-skyloft.sh; do
    if [[ ! -f "$helpers/$runner" && -f "scripts/$runner" ]]; then
        install -m 0755 "scripts/$runner" "$helpers/$runner"
    fi
done
if ((publish)); then
    echo 'Checking GitHub publishing access…'
    bash "$helpers/publish-skyloft.sh" --check
fi
if ((android)); then
    echo '=== Android ==='
    bash "$helpers/build-skyloft-android.sh"
    bash "$storage/projects/FlXtR/check-signing.sh"
fi
if ((steamlink)); then
    echo '=== Steam Link ==='
    bash "$helpers/build-skyloft-steamlink.sh"
fi
if ((linux)); then
    echo '=== Linux x86-64 ==='
    bash "$helpers/build-skyloft-desktop.sh" --linux
fi
if ((windows)); then
    echo '=== Windows x86-64 ==='
    bash "$helpers/build-skyloft-desktop.sh" --windows
fi
if [[ -n "$output" ]]; then
    mkdir -p "$output"
    if ((android)); then cp -- "$repo/dist/FlXtR-Android-preview.apk" "$output/"; fi
    if ((steamlink)); then cp -- "$repo/dist/greenlink.tgz" "$output/"; fi
    if ((linux)); then cp -- "$repo/dist/FlXtR-Linux-x86_64.tgz" "$output/"; fi
    if ((windows)); then cp -- "$repo/dist/FlXtR-Windows-x86_64.zip" "$output/"; fi
fi
if ((publish)); then
    # With --all, finish both builds before advancing either update channel.
    if ((android)); then bash "$helpers/publish-skyloft.sh" --android; fi
    if ((steamlink)); then bash "$helpers/publish-skyloft.sh" --steamlink; fi
    if ((linux)); then bash "$helpers/publish-skyloft.sh" --linux; fi
    if ((windows)); then bash "$helpers/publish-skyloft.sh" --windows; fi
    echo 'Publishing complete.'
else
    echo 'Publishing skipped (--no-publish).'
fi
printf '\nBuild complete. Artifacts: %s/dist\nLog: %s\n' "$repo" "$log"
