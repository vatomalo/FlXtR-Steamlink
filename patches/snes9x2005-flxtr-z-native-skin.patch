+
+static INLINE uint8_t *flxtr_name_mask_tile(const uint8_t *source)
+{
+   static uint8_t masked[64];
+   unsigned i;
+   for (i = 0; i < 64; i++)
+      masked[i] = (flxtr_name_hide & (1u << source[i])) ? 0 : source[i];
+   return masked;
+}
+
+static INLINE uint16_t *flxtr_name_tint(const uint16_t *source)
+{
+   static uint16_t palette[16];
+   unsigned i;
+   memcpy(palette, source, sizeof(palette));
+   for (i = flxtr_name_actor ? 1 : 0; i < 3; i++)
+   {
+      const unsigned rgb = flxtr_name_skin[i];
+      if (rgb != 0xffff && IPPU.XB)
+         palette[5 + i] = BUILD_PIXEL(IPPU.XB[rgb & 31],
+               IPPU.XB[(rgb >> 5) & 31], IPPU.XB[(rgb >> 10) & 31]);
+   }
+   return palette;
+}
+

