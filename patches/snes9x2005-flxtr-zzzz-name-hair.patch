+++ b/source/tile.h
@@ -5,6 +5,7 @@
 
 extern const uint8_t *flxtr_obj_pixels;
 extern const uint16_t *flxtr_name_skin;
+extern const uint16_t *flxtr_name_hair;
 extern unsigned flxtr_name_actor;
