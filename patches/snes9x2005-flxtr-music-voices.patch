+/* The common effect masks use a reduced DSP schedule. A lower voice uses
+   the full schedule with the same output gate, including its echo send. */
+static void dsp_run_fx0( int32_t clocks_remain )
+{
+   int32_t phase;
+   phase = dsp_m.phase;
+   dsp_m.phase = (phase + clocks_remain) & 31;
+
+   switch ( phase )
+   {
+loop:
+      if ( 0 && !--clocks_remain )
+         break;
+      case 0:
+      if ( 1 && !--clocks_remain )
+         break;
+      case 1:
+      if ( 2 && !--clocks_remain )
+         break;
+      case 2:
+      if ( 3 && !--clocks_remain )
+         break;
+      case 3:
+      if ( 4 && !--clocks_remain )
+         break;
+      case 4:
+      if ( 5 && !--clocks_remain )
+         break;
+      case 5:
+      if ( 6 && !--clocks_remain )
+         break;
+      case 6:
+      if ( 7 && !--clocks_remain )
+         break;
+      case 7:
+      if ( 8 && !--clocks_remain )
+         break;
+      case 8:
+      if ( 9 && !--clocks_remain )
+         break;
+      case 9:
+      if ( 10 && !--clocks_remain )
+         break;
+      case 10:
+      if ( 11 && !--clocks_remain )
+         break;
+      case 11:
+      if ( 12 && !--clocks_remain )
+         break;
+      case 12:
+      if ( 13 && !--clocks_remain )
+         break;
+      case 13:
+      if ( 14 && !--clocks_remain )
+         break;
+      case 14:
+      if ( 15 && !--clocks_remain )
+         break;
+      case 15:
+      if ( 16 && !--clocks_remain )
+         break;
+      case 16:
+      if ( 17 && !--clocks_remain )
+         break;
+      case 17:
+      if ( 18 && !--clocks_remain )
+         break;
+      case 18:
+      if ( 19 && !--clocks_remain )
+         break;
+      case 19:
+      if ( 20 && !--clocks_remain )
+         break;
+      case 20:
+      if ( 21 && !--clocks_remain )
+         break;
+      case 21:
+      if ( 22 && !--clocks_remain )
+         break;
+      case 22:
+      dsp_echo_22();
+      if ( 23 && !--clocks_remain )
+         break;
+      case 23:
+      dsp_echo_23();
+      if ( 24 && !--clocks_remain )
+         break;
+      case 24:
+      dsp_echo_24();
+      if ( 25 && !--clocks_remain )
+         break;
+      case 25:
+      dsp_echo_25();
+      if ( 26 && !--clocks_remain )
+         break;
+      case 26:
+      dsp_echo_26();
+      if ( 27 && !--clocks_remain )
+         break;
+      case 27:
+      MISC_27();
+      dsp_echo_27();
+      if ( 28 && !--clocks_remain )
+         break;
+      case 28:
+      MISC_28();
+      ECHO_28();
+      if ( 29 && !--clocks_remain )
+         break;
+      case 29:
+      MISC_29();
+      dsp_echo_29();
+      if ( 30 && !--clocks_remain )
+         break;
+      case 30:
+      dsp_misc_30();
+      ECHO_WRITE(1);
+      if ( 31 && !--clocks_remain )
+         break;
+      case 31:
+
+      if ( --clocks_remain )
+         goto loop;
+   }
+}
