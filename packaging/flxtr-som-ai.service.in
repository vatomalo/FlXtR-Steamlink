[Unit]
Description=FlXtR Secret of Mana tile-aware AI bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/flxtr/som-ai.env
ExecStart=/bin/bash @REPO@/scripts/run-som-ai-service.sh
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
